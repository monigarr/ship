server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    set $api_health_fallback "${API_HEALTH_FALLBACK}";

    # Frontend SPA routes.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # REST API proxy.
    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout ${PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${PROXY_READ_TIMEOUT};
        proxy_send_timeout ${PROXY_SEND_TIMEOUT};
        proxy_intercept_errors on;
        error_page 502 503 504 = @api_health_fallback;
        proxy_pass ${API_UPSTREAM};
    }

    # WebSocket endpoints used by realtime collaboration/events.
    location /collaboration {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout ${PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${PROXY_READ_TIMEOUT};
        proxy_send_timeout ${PROXY_SEND_TIMEOUT};
        proxy_pass ${API_UPSTREAM};
    }

    location /events {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout ${PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${PROXY_READ_TIMEOUT};
        proxy_send_timeout ${PROXY_SEND_TIMEOUT};
        proxy_pass ${API_UPSTREAM};
    }

    # Optional degraded response for health-style checks when API is unavailable.
    location @api_health_fallback {
        if ($uri !~ "^/api/(health|setup/status)$") {
            return 502;
        }

        if ($api_health_fallback != "1") {
            return 502;
        }

        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"status":"degraded","upstream":"unavailable"}';
    }
}
