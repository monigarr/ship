set -e

# Fail on empty Playwright tests (they silently pass - major footgun)
if [ -f "./scripts/check-empty-tests.sh" ]; then
  ./scripts/check-empty-tests.sh
fi

# Check API coverage for new UI routes
if [ -f "./scripts/check-api-coverage.sh" ]; then
  ./scripts/check-api-coverage.sh --staged
fi

# Required local security scanners (fail-closed)
DOCKER_BIN=""
if command -v docker.exe >/dev/null 2>&1; then
  DOCKER_BIN="docker.exe"
elif command -v docker >/dev/null 2>&1; then
  DOCKER_BIN="docker"
fi

if [ -z "$DOCKER_BIN" ]; then
  echo ""
  echo "ERROR: Docker is required for pre-commit security checks."
  echo "Install/start Docker Desktop, then retry commit."
  echo ""
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
REPO_MOUNT="$REPO_ROOT"
if [ "$DOCKER_BIN" = "docker.exe" ]; then
  if command -v cygpath >/dev/null 2>&1; then
    REPO_MOUNT="$(cygpath -w "$REPO_ROOT")"
  elif command -v wslpath >/dev/null 2>&1; then
    REPO_MOUNT="$(wslpath -w "$REPO_ROOT")"
  fi
fi

run_docker() {
  if [ "$DOCKER_BIN" = "docker.exe" ] || [ -n "$MSYSTEM" ]; then
    MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL="*" "$DOCKER_BIN" "$@"
  else
    "$DOCKER_BIN" "$@"
  fi
}

echo "Running staged gitleaks secret scan..."
run_docker run --rm -v "$REPO_MOUNT:/repo" -w /repo zricethezav/gitleaks:latest git /repo --staged --redact --no-banner --exit-code 1

echo "Running trivy secret/misconfig scan..."
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -n "$STAGED_FILES" ]; then
  for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
      run_docker run --rm -v "$REPO_MOUNT:/repo" aquasec/trivy:latest filesystem --scanners misconfig,secret --severity HIGH,CRITICAL --exit-code 1 --quiet "/repo/$file"
    fi
  done
else
  echo "No staged files for trivy scan."
fi
